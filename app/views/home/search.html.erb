<section class="results"
         data-controller="idle-reset"
         data-idle-reset-url-value="<%= root_path %>"
         data-action="pointerdown@window->idle-reset#touch keydown@window->idle-reset#touch scroll@window->idle-reset#touch visibilitychange@document->idle-reset#check pageshow@window->idle-reset#check">
  <%= render "search_form", city: params[:city] %>

  <% if @weather.found? %>
    <article class="weather-card weather-card--<%= @weather.theme %>">
      <header class="weather-card__header">
        <div>
          <h1 class="weather-card__city"><%= @weather.city %><% if @weather.country %><span class="weather-card__country"><%= @weather.country %></span><% end %></h1>
          <p class="weather-card__date"><%= @weather.local_time.strftime("%A, %B %-d · %-I:%M %p") %> local time</p>
        </div>
      </header>

      <div class="weather-card__main">
        <div>
          <p class="weather-card__temp"><%= @weather.temperature %><span>°C</span></p>
          <p class="weather-card__sky"><%= @weather.sky %></p>
          <p class="weather-card__range">
            Feels like <%= @weather.feels_like %>° · H <%= @weather.temp_max %>° · L <%= @weather.temp_min %>°
          </p>
        </div>
        <%= image_tag @weather.icon, alt: @weather.sky, class: "weather-card__icon", width: 160, height: 160 %>
      </div>

      <dl class="weather-card__stats">
        <div><dt>Humidity</dt><dd><%= @weather.humidity %>%</dd></div>
        <div><dt>Wind</dt><dd><%= @weather.wind_speed_kmh %> km/h</dd></div>
        <div><dt>Pressure</dt><dd><%= @weather.pressure %> hPa</dd></div>
        <% if @weather.visibility_km %>
          <div><dt>Visibility</dt><dd><%= @weather.visibility_km %> km</dd></div>
        <% end %>
        <% if @weather.sunrise %>
          <div><dt>Sunrise</dt><dd><%= @weather.sunrise.strftime("%-I:%M %p") %></dd></div>
          <div><dt>Sunset</dt><dd><%= @weather.sunset.strftime("%-I:%M %p") %></dd></div>
        <% end %>
      </dl>
    </article>
  <% else %>
    <%= render "layouts/partials/flash_alert" %>
  <% end %>
</section>
