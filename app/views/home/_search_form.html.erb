<%= form_with url: search_path, method: :get, class: "search", data: { controller: "city-search", city_search_url_value: cities_path, action: "keydown->city-search#navigate click@window->city-search#closeOnOutsideClick" } do |form| %>
  <div class="search__field">
    <svg class="search__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <%= form.text_field :city,
          value: local_assigns[:city],
          placeholder: "Search for a city",
          autocomplete: "off",
          class: "search__input",
          role: "combobox",
          aria: { label: "City", autocomplete: "list", expanded: "false", controls: "city-suggestions" },
          data: { city_search_target: "input", action: "input->city-search#search" } %>
    <%= form.hidden_field :lat, data: { city_search_target: "lat" }, id: nil %>
    <%= form.hidden_field :lon, data: { city_search_target: "lon" }, id: nil %>
    <button type="submit" class="search__button">Search</button>
  </div>
  <ul id="city-suggestions" class="search__suggestions" role="listbox" hidden data-city-search-target="list"></ul>
<% end %>
